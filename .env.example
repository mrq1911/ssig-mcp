# Local HTTP server
SSIG_HOST=127.0.0.1
SSIG_PORT=3721

# Explicit trusted-LAN mode (plain HTTP; prefer an SSH tunnel on untrusted networks):
# SSIG_HOST=0.0.0.0
# SSIG_ALLOW_LAN=true
# SSIG_PUBLIC_HOST=192.168.1.50
# SSIG_DATA_DIR=/absolute/private/path

# Simulation policy
SSIG_REQUIRE_SIMULATION=false
SSIG_BLOCK_FAILED_SIMULATION=true

# Tenderly (set all three or none)
# SSIG_TENDERLY_ACCOUNT=
# SSIG_TENDERLY_PROJECT=
# SSIG_TENDERLY_ACCESS_KEY=

# Admin-controlled simulation endpoints (JSON objects)
# SSIG_EVM_RPC_URLS={"1":"https://ethereum.example/rpc"}
# SSIG_SOLANA_RPC_URLS={"solana:devnet":"https://api.devnet.solana.com"}
# SSIG_SUI_GRPC_URLS={"sui:testnet":"https://fullnode.testnet.sui.io:443"}
